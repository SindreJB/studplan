{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studplan",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/web/src/server.ts",
  "triggers": {
    "crons": ["0 3 * * *", "0 4 * * 1"],
  },
  // Requires the studplan.no zone to be Active in Cloudflare — a deploy fails
  // while it is still Pending. Comment this block out to fall back to the
  // workers.dev subdomain, and set APP_URL below to match.
  "routes": [
    {
      "pattern": "studplan.no",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    // Better Auth's baseURL, and the hostname password-reset mail is sent from.
    // It must match the address the Worker is actually served on, or sign-in
    // cookies and reset links break.
    "APP_URL": "https://studplan.no",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studplan",
      "migrations_dir": "packages/db/migrations",
      "migrations_pattern": "packages/db/migrations/*/migration.sql",
    },
  ],
}
