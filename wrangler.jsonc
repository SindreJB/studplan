{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studplan",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/web/src/server.ts",
  "triggers": {
    "crons": ["0 3 * * *", "0 4 * * 0"],
  },
  "routes": [
    {
      "pattern": "studplan.ahse.dev",
      "custom_domain": true,
    },
  ],
  "vars": {
    "APP_URL": "https://studplan.ahse.dev",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studplan",
      "migrations_dir": "packages/db/migrations",
      "migrations_pattern": "packages/db/migrations/*/migration.sql",
    },
  ],
}
