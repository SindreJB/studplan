{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studplan",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "apps/web/src/server.ts",
  "triggers": {
    "crons": ["0 3 * * *", "0 4 * * 1"],
  },
  // No "routes" block: the Worker is served on your workers.dev subdomain.
  // Once your domain's nameservers are live in Cloudflare, add it back as:
  //
  //   "routes": [{ "pattern": "studplan.example.com", "custom_domain": true }],
  //
  // and set APP_URL below to that same https:// address.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    // Better Auth's baseURL, and the hostname password-reset mail is sent from.
    // It must match the address the Worker is actually served on, or sign-in
    // cookies and reset links break. The first `vp run deploy` prints the
    // workers.dev URL — put it here and deploy again.
    "APP_URL": "https://studplan.CHANGE-ME.workers.dev",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studplan",
      "migrations_dir": "packages/db/migrations",
      "migrations_pattern": "packages/db/migrations/*/migration.sql",
    },
  ],
}
