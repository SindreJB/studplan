{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vp dev",
    "preview": "vp preview",
    "deploy": "vp run build && wrangler d1 migrations apply studplan --remote --config ../../wrangler.jsonc && wrangler secret bulk ../../.env.prod --config ../../wrangler.jsonc && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply studplan --local --persist-to .wrangler/state --config ../../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply studplan --remote --config ../../wrangler.jsonc",
    "cf-typegen": "wrangler types --config ../../wrangler.jsonc",
    "ui": "vpx shadcn@latest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "better-result": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "nanoid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-a11y": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "cross-env": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
